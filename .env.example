# --- Database ---
POSTGRES_USER=agents42
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agents42
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agents42:change-me@postgres:5432/agents42

# --- Business profiles ---
# Directory containing <business_id>.yaml profiles, mounted into the app container.
BUSINESSES_DIR=/app/businesses

# --- Google Calendar ---
# Path to the OAuth client secret downloaded from Google Cloud Console (never commit this file).
GOOGLE_CALENDAR_CREDENTIALS_PATH=/app/credentials/calendar_credentials.json
# Path to the token generated by `python -m agents42.integrations.google_calendar_auth`
# after a one-time local browser OAuth flow. Mount this file read-only on AWS.
GOOGLE_CALENDAR_TOKEN_PATH=/app/credentials/calendar_token.json

# --- LLM provider (used by OpenClaw, running natively on the host - see DEVELOPMENT.md) ---
# Local development: point at a cheap tool-capable model.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Final integration: hackathon AWS Bedrock gateway (Ollama-compatible, see DEVELOPMENT.md
# for why tool-calls must be emitted/parsed manually against this gateway).
# LLM_PROVIDER=hackathon_gateway
# LLM_GATEWAY_URL=
# LLM_GATEWAY_API_KEY=
# LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Backend API, as seen by OpenClaw's skill scripts running on the host ---
AGENTS42_API_BASE_URL=http://localhost:8090
