# --- Database ---
POSTGRES_USER=agents42
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agents42
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://agents42:change-me@postgres:5432/agents42

# --- Business profiles ---
# Directory containing <business_id>.yaml profiles, mounted into the app container.
BUSINESSES_DIR=/app/businesses

# --- Google Calendar ---
# Path to the OAuth client secret downloaded from Google Cloud Console (never commit this file).
GOOGLE_CALENDAR_CREDENTIALS_PATH=/app/credentials/calendar_credentials.json
# Path to the token generated by `python -m agents42.integrations.google_calendar_auth`
# after a one-time local browser OAuth flow. Must stay writable (not read-only) - the
# Calendar client rewrites this file on every access-token refresh; see DEVELOPMENT.md
# "Google Calendar setup" step 5.
GOOGLE_CALENDAR_TOKEN_PATH=/app/credentials/calendar_token.json

# --- LLM provider ---
# NOT read by this app. OpenClaw (running natively on the host, not in this
# Docker stack) manages its own model-provider auth in ~/.openclaw/openclaw.json,
# configured via `openclaw onboard` - see SETUP.md "Connect an LLM provider".
# Nothing to set here.

# --- Backend API, as seen by OpenClaw's skill scripts running on the host ---
AGENTS42_API_BASE_URL=http://localhost:8090

# --- Owner dashboard (owner_api.py) ---
# Single shared password for HTTP Basic Auth (any username accepted) - see
# DEVELOPMENT.md "Owner dashboard". Change this before deploying anywhere real.
OWNER_DASHBOARD_PASSWORD=change-me
# Which business this deployment's dashboard is for - must match a
# businesses/<id>.yaml file. This project only supports one business per
# deployment for now (see AGENTS42.md "Not in this slice").
OWNER_DASHBOARD_BUSINESS_ID=demo-groomer

# --- Owner escalation email notifications (integrations/email_notifier.py) ---
# All optional - if OWNER_NOTIFICATION_EMAIL or SMTP_HOST is unset, escalations
# are still created and shown on the dashboard's Attention queue as normal;
# they just aren't emailed. See DEVELOPMENT.md "Owner escalation emails".
OWNER_NOTIFICATION_EMAIL=
# Plain SMTP+STARTTLS - a standalone app password on whatever mailbox the
# business already checks, not a provider-specific API. For Gmail: create an
# App Password (myaccount.google.com/apppasswords) on that account - a
# regular account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
